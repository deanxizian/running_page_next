{
  "name": "running-page-next",
  "description": "Strava-backed running dashboard",
  "version": "1.0.0",
  "author": "Dean Xi",
  "packageManager": "pnpm@8.9.0+sha256.8f5264ad1d100da11a6add6bb8a94c6f1e913f9e9261b2a551fabefad2ec0fec",
  "dependencies": {
    "@mapbox/polyline": "^1.2.1",
    "@math.gl/web-mercator": "^4.1.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "@vis.gl/react-maplibre": "^8.1.1",
    "maplibre-gl": "^5.24.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0"
  },
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "data:clean": "rm -f run_page/data.db run_page/data.db.enc src/static/activities.json src/static/activity_routes.json src/static/event_routes.json",
    "data:validate": "python3 run_page/validate_activities.py src/static/activities.json src/static/activity_routes.json src/static/event_routes.json",
    "data:sync:strava": "python3 run_page/strava_sync.py \"$STRAVA_CLIENT_ID\" \"$STRAVA_CLIENT_SECRET\" \"$STRAVA_CLIENT_REFRESH_TOKEN\" --only-run",
    "data:sync:strava:refresh-locations": "python3 run_page/strava_sync.py \"$STRAVA_CLIENT_ID\" \"$STRAVA_CLIENT_SECRET\" \"$STRAVA_CLIENT_REFRESH_TOKEN\" --only-run --force --refresh-locations",
    "build": "vite build",
    "dev": "vite dev",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "python:check": "python3 -m ruff check run_page && python3 -m ruff format --check run_page",
    "python:format": "python3 -m ruff format run_page",
    "python:test": "python3 -m unittest discover -s run_page -p 'test_*.py'",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "check": "pnpm typecheck && pnpm lint && pnpm format && pnpm data:validate && pnpm test && pnpm build",
    "check:ci": "pnpm check && pnpm python:check && pnpm python:test && pnpm test:e2e",
    "typecheck": "tsc --noEmit",
    "serve": "vite preview"
  },
  "engineStrict": true,
  "browserslist": "defaults, not ie 11",
  "engines": {
    "node": "24.x"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "overrides": {
      "@babel/core": "7.29.7",
      "@napi-rs/wasm-runtime": "1.1.6",
      "brace-expansion@<5.0.8": "5.0.8",
      "browserslist": "4.28.7",
      "caniuse-lite": "1.0.30001806",
      "js-yaml": "4.3.0",
      "picomatch": "4.0.5",
      "postcss": "8.5.23",
      "protocol-buffers-schema": "3.6.1",
      "undici": "7.29.0"
    },
    "patchedDependencies": {
      "minimatch@3.1.5": "patches/minimatch@3.1.5.patch"
    }
  }
}
